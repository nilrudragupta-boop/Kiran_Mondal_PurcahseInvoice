        <div id="toast">Invoice saved successfully!</div>

        <script>
            function formatCurrency(num) {
                return '₹' + Number(num || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            // Renumber item rows sequentially
            function updateSerialNumbers() {
                const rows = document.querySelectorAll('.item-row');
                rows.forEach((row, index) => {
                    const slNoEl = row.querySelector('.item-sl-no');
                    if (slNoEl) {
                        slNoEl.innerText = index + 1;
                    }
                });
            }

            // Convert Number to Words (Indian Numbering Format: Lakhs & Crores)
            function numberToWordsINR(amount) {
                if (isNaN(amount) || amount === 0) return 'Zero Rupees Only';

                const units = ['', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine'];
                const teens = ['Ten', 'Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen', 'Seventeen', 'Eighteen', 'Nineteen'];
                const tens = ['', '', 'Twenty', 'Thirty', 'Forty', 'Fifty', 'Sixty', 'Seventy', 'Eighty', 'Ninety'];

                function convertTwoDigits(n) {
                    if (n < 10) return units[n];
                    if (n >= 10 && n < 20) return teens[n - 10];
                    const unit = n % 10;
                    return tens[Math.floor(n / 10)] + (unit ? ' ' + units[unit] : '');
                }

                function convertThreeDigits(n) {
                    let str = '';
                    const hundred = Math.floor(n / 100);
                    const rem = n % 100;
                    if (hundred > 0) {
                        str += units[hundred] + ' Hundred';
                        if (rem > 0) str += ' and ';
                    }
                    if (rem > 0) {
                        str += convertTwoDigits(rem);
                    }
                    return str;
                }

                let [rupeesPart, paisePart] = amount.toFixed(2).split('.');
                let num = parseInt(rupeesPart, 10);
                let words = '';

                if (num === 0) {
                    words = 'Zero';
                } else {
                    const crore = Math.floor(num / 10000000);
                    num %= 10000000;

                    const lakh = Math.floor(num / 100000);
                    num %= 100000;

                    const thousand = Math.floor(num / 1000);
                    num %= 1000;

                    const remainder = num;

                    if (crore > 0) words += convertThreeDigits(crore) + ' Crore ';
                    if (lakh > 0) words += convertTwoDigits(lakh) + ' Lakh ';
                    if (thousand > 0) words += convertTwoDigits(thousand) + ' Thousand ';
                    if (remainder > 0) words += convertThreeDigits(remainder) + ' ';
                }

                words = words.trim() + ' Rupees';

                const paise = parseInt(paisePart, 10);
                if (paise > 0) {
                    words += ' and ' + convertTwoDigits(paise) + ' Paise';
                }

                return words + ' Only';
            }

            function calculateTotals() {
                const rows = document.querySelectorAll('.item-row');
                let subtotal = 0;

                rows.forEach(row => {
                    const qty = parseFloat(row.querySelector('.item-qty').value) || 0;
                    const price = parseFloat(row.querySelector('.item-price').value) || 0;
                    const rowTotal = qty * price;
                    subtotal += rowTotal;
                    row.querySelector('.item-row-total').innerText = formatCurrency(rowTotal);
                });

                // Discount calculation (% or flat ₹)
                const discountType = document.getElementById('discountType').value;
                const discountRaw = document.getElementById('discountValue').value;
                const discountNum = parseFloat(discountRaw) || 0;

                let discountAmount = 0;
                if (discountType === '%') {
                    discountAmount = subtotal * (discountNum / 100);
                    document.getElementById('discountPrintLabel').innerText = `(${discountNum}%)`;
                } else {
                    discountAmount = discountNum;
                    document.getElementById('discountPrintLabel').innerText = `(₹${discountNum})`;
                }
                discountAmount = Math.min(subtotal, Math.max(0, discountAmount));
                const taxableAmount = Math.max(0, subtotal - discountAmount);

                // Tax calculation
                const taxInput = document.getElementById('taxRate').value;
                const taxRate = parseFloat(taxInput) || 0;
                const taxAmount = taxableAmount * (taxRate / 100);
                document.getElementById('taxPrintLabel').innerText = `(${taxRate}%)`;

                // Optional Round Off calculation
                let unroundedTotal = taxableAmount + taxAmount;
                let roundOffDifference = 0;
                let grandTotal = unroundedTotal;

                const isRoundOffEnabled = document.getElementById('enableRoundOff').checked;
                if (isRoundOffEnabled) {
                    grandTotal = Math.round(unroundedTotal);
                    roundOffDifference = grandTotal - unroundedTotal;
                }

                document.getElementById('subtotalVal').innerText = formatCurrency(subtotal);
                document.getElementById('discountVal').innerText = '-' + formatCurrency(discountAmount);
                document.getElementById('taxVal').innerText = formatCurrency(taxAmount);
                document.getElementById('roundOffVal').innerText = (roundOffDifference >= 0 ? '+' : '') + formatCurrency(roundOffDifference);
                document.getElementById('grandTotalVal').innerText = formatCurrency(grandTotal);

                // Update Total Due in Words
                document.getElementById('totalInWords').innerText = numberToWordsINR(grandTotal);

                // Dynamic PDF/Print Visibility Logic
                const discountRow = document.getElementById('discountRow');
                if (discountNum === 0 || discountRaw.trim() === '') {
                    discountRow.classList.add('hide-on-print');
                } else {
                    discountRow.classList.remove('hide-on-print');
                }

                const taxRow = document.getElementById('taxRow');
                if (taxRate === 0 || taxInput.trim() === '') {
                    taxRow.classList.add('hide-on-print');
                } else {
                    taxRow.classList.remove('hide-on-print');
                }

                const roundOffRow = document.getElementById('roundOffRow');
                if (!isRoundOffEnabled || Math.abs(roundOffDifference) < 0.001) {
                    roundOffRow.classList.add('hide-on-print');
                } else {
                    roundOffRow.classList.remove('hide-on-print');
                }
            }

            function addRow() {
                const tbody = document.getElementById('itemsBody');
                const tr = document.createElement('tr');
                tr.className = 'item-row';
                tr.innerHTML = `
            <td class="text-center">
                <span class="item-sl-no"></span>
            </td>
            <td>
                <input type="text" class="item-title" placeholder="Item name" style="font-weight:600; margin-bottom:4px;">
                <input type="text" class="item-desc" placeholder="Description" style="font-size:11.5px; color:#64748b;">
            </td>
            <td>
                <input type="text" class="item-uom text-center" value="PCS" placeholder="UoM">
            </td>
            <td>
                <input type="number" class="item-qty text-center" value="1" min="0" step="any" oninput="calculateTotals()">
            </td>
            <td>
                <input type="number" class="item-price text-right" value="0" min="0" step="any" oninput="calculateTotals()">
            </td>
            <td class="text-right">
                <span class="item-row-total">₹0.00</span>
            </td>
            <td class="text-center no-print">
                <button class="btn btn-danger" onclick="deleteRow(this)" title="Delete Row">✕</button>
            </td>
        `;
                tbody.appendChild(tr);
                updateSerialNumbers();
                calculateTotals();
            }

            function deleteRow(btn) {
                const rows = document.querySelectorAll('.item-row');
                if (rows.length > 1) {
                    btn.closest('tr').remove();
                    updateSerialNumbers();
                    calculateTotals();
                } else {
                    showToast('You must keep at least one line item.');
                }
            }

            function exportPDF() {
                calculateTotals();
                window.print();
            }

            function showToast(msg) {
                const toast = document.getElementById('toast');
                toast.innerText = msg;
                toast.style.display = 'block';
                setTimeout(() => {
                    toast.style.display = 'none';
                }, 2500);
            }

            function saveToStorage() {
                const data = {
                    companyName: document.getElementById('companyName').value,
                    companyDetails: document.getElementById('companyDetails').value,
                    invoiceNumber: document.getElementById('invoiceNumber').value,
                    invoiceDate: document.getElementById('invoiceDate').value,
                    clientName: document.getElementById('clientName').value,
                    clientAddress: document.getElementById('clientAddress').value,
                    paymentTerms: document.getElementById('paymentTerms').value,
                    notes: document.getElementById('notes').value,
                    signerName: document.getElementById('signerName').value,
                    discountType: document.getElementById('discountType').value,
                    discountValue: document.getElementById('discountValue').value,
                    taxRate: document.getElementById('taxRate').value,
                    enableRoundOff: document.getElementById('enableRoundOff').checked,
                    items: []
                };

                document.querySelectorAll('.item-row').forEach(row => {
                    data.items.push({
                        title: row.querySelector('.item-title').value,
                        desc: row.querySelector('.item-desc').value,
                        uom: row.querySelector('.item-uom').value,
                        qty: row.querySelector('.item-qty').value,
                        price: row.querySelector('.item-price').value
                    });
                });

                localStorage.setItem('saved_invoice_data', JSON.stringify(data));
                showToast('Invoice data saved to browser memory!');
            }

            function loadFromStorage() {
                const raw = localStorage.getItem('saved_invoice_data');
                if (!raw) {
                    showToast('No saved invoice found in browser memory.');
                    return;
                }

                try {
                    const data = JSON.parse(raw);
                    document.getElementById('companyName').value = data.companyName || '';
                    document.getElementById('companyDetails').value = data.companyDetails || '';
                    document.getElementById('invoiceNumber').value = data.invoiceNumber || '';
                    document.getElementById('invoiceDate').value = data.invoiceDate || '';
                    document.getElementById('clientName').value = data.clientName || '';
                    document.getElementById('clientAddress').value = data.clientAddress || '';
                    document.getElementById('paymentTerms').value = data.paymentTerms || '';
                    document.getElementById('notes').value = data.notes || '';
                    document.getElementById('signerName').value = data.signerName || 'Rabindranath Mondal';
                    document.getElementById('discountType').value = data.discountType || '%';
                    document.getElementById('discountValue').value = data.discountValue !== undefined ? data.discountValue : (data.discountRate || 0);
                    document.getElementById('taxRate').value = data.taxRate || 0;
                    document.getElementById('enableRoundOff').checked = !!data.enableRoundOff;

                    const tbody = document.getElementById('itemsBody');
                    tbody.innerHTML = '';
                    (data.items || []).forEach(item => {
                        const tr = document.createElement('tr');
                        tr.className = 'item-row';
                        tr.innerHTML = `
                    <td class="text-center">
                        <span class="item-sl-no"></span>
                    </td>
                    <td>
                        <input type="text" class="item-title" value="${item.title || ''}" placeholder="Item name" style="font-weight:600; margin-bottom:4px;">
                        <input type="text" class="item-desc" value="${item.desc || ''}" placeholder="Item description" style="font-size:11.5px; color:#64748b;">
                    </td>
                    <td>
                        <input type="text" class="item-uom text-center" value="${item.uom || 'PCS'}" placeholder="UoM">
                    </td>
                    <td>
                        <input type="number" class="item-qty text-center" value="${item.qty || 1}" min="0" step="any" oninput="calculateTotals()">
                    </td>
                    <td>
                        <input type="number" class="item-price text-right" value="${item.price || 0}" min="0" step="any" oninput="calculateTotals()">
                    </td>
                    <td class="text-right">
                        <span class="item-row-total">₹0.00</span>
                    </td>
                    <td class="text-center no-print">
                        <button class="btn btn-danger" onclick="deleteRow(this)" title="Delete Row">✕</button>
                    </td>
                `;
                        tbody.appendChild(tr);
                    });

                    updateSerialNumbers();
                    calculateTotals();
                    showToast('Invoice loaded successfully!');
                } catch (e) {
                    showToast('Failed to load saved invoice.');
                }
            }

            function resetForm() {
                if (confirm('Are you sure you want to reset all fields?')) {
                    location.reload();
                }
            }

            updateSerialNumbers();
            calculateTotals();
        </script>

</body>

</html>
