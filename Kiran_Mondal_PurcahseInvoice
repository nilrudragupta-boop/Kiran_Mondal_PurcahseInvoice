                                    class="no-print">
                                    <option value="%">%</option>
                                    <option value="₹">₹</option>
                                </select>
                                <input type="number" id="discountValue" value="0" min="0" step="any"
                                    style="width:65px; display:inline-block; margin-left:4px;"
                                    oninput="calculateTotals()">
                                <span id="discountPrintLabel" class="print-only-inline"></span>
                            </td>
                            <td class="total-val" id="discountVal">-₹0.00</td>
                        </tr>
                        <tr id="taxRow">
                            <td style="color:#64748b;">
                                GST / Tax (%):
                                <input type="number" id="taxRate" value="18" min="0" max="100" step="any"
                                    style="width:65px; display:inline-block; margin-left:6px;"
                                    oninput="calculateTotals()">
                                <span id="taxPrintLabel" class="print-only-inline"></span>
                            </td>
                            <td class="total-val" id="taxVal">₹0.00</td>
                        </tr>
