                    <tr class="item-row">
                        <td class="text-center">
                            <span class="item-sl-no">2</span>
                        </td>
                        <td>
                            <input type="text" class="item-title" value="" placeholder="Item name"
                                style="font-weight:600; margin-bottom:4px;">
                            <input type="text" class="item-desc" value="" placeholder="Description"
                                style="font-size:11.5px; color:#64748b;">
                        </td>
                        <td>
                            <input type="text" class="item-uom text-center" value="PCS" placeholder="UoM">
                        </td>
                        <td>
                            <input type="number" class="item-qty text-center" value="1" min="0" step="any"
                                oninput="calculateTotals()">
                        </td>
                        <td>
                            <input type="number" class="item-price text-right" value="0" min="0" step="any"
